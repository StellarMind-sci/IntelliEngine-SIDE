{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "cognitive_nodes",
    "knowledge_units"
  ],
  "properties": {
    "cognitive_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "object_result"
        ],
        "properties": {
          "ref": {
            "type": "object",
            "required": [
              "id",
              "revision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "object_result": {
            "enum": [
              "available",
              "invalid",
              "opaque",
              "compatible_read"
            ]
          },
          "document": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "knowledge_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "object_result"
        ],
        "properties": {
          "ref": {
            "type": "object",
            "required": [
              "id",
              "revision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "object_result": {
            "enum": [
              "available",
              "invalid",
              "opaque",
              "compatible_read"
            ]
          },
          "document": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
