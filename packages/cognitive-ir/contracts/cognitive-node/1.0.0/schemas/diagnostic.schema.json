{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["code", "path", "severity"],
  "properties": {
    "code": {"minLength": 1, "type": "string"},
    "path": {"pattern": "^(?:|(?:/(?:[^~/]|~0|~1)*)*)$", "type": "string"},
    "severity": {"enum": ["error", "warning", "info"]},
    "details": {"type": "object"}
  },
  "additionalProperties": false
}
