{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["contract_version", "self_digest", "entries"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "self_digest": {"const": "excluded"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "digest_kind", "sha256"],
        "properties": {
          "path": {"pattern": "^[A-Za-z0-9._/-]+$", "type": "string"},
          "digest_kind": {"const": "jcs_sha256"},
          "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
