            },
            "exclusiveMaximum": {
              "$ref": "#/$defs/keywordRule"
            },
            "minimum": {
              "$ref": "#/$defs/keywordRule"
            },
            "exclusiveMinimum": {
              "$ref": "#/$defs/keywordRule"
            },
            "maxLength": {
              "$ref": "#/$defs/keywordRule"
            },
            "minLength": {
              "$ref": "#/$defs/keywordRule"
            },
            "pattern": {
              "$ref": "#/$defs/keywordRule"
            },
            "maxItems": {
              "$ref": "#/$defs/keywordRule"
            },
            "minItems": {
              "$ref": "#/$defs/keywordRule"
            },
            "uniqueItems": {
              "$ref": "#/$defs/keywordRule"
            },
            "maxProperties": {
              "$ref": "#/$defs/keywordRule"
            },
            "minProperties": {
              "$ref": "#/$defs/keywordRule"
            },
            "required": {
              "$ref": "#/$defs/keywordRule"
            },
            "dependentRequired": {
              "$ref": "#/$defs/keywordRule"
            },
            "title": {
              "$ref": "#/$defs/keywordRule"
            },
            "description": {
              "$ref": "#/$defs/keywordRule"
            },
            "default": {
              "$ref": "#/$defs/keywordRule"
            },
            "deprecated": {
              "$ref": "#/$defs/keywordRule"
            },
            "readOnly": {
              "$ref": "#/$defs/keywordRule"
            },
            "writeOnly": {
              "$ref": "#/$defs/keywordRule"
            },
            "examples": {
              "$ref": "#/$defs/keywordRule"
            },
            "format": {
              "$ref": "#/$defs/keywordRule"
            },
            "contentEncoding": {
              "$ref": "#/$defs/keywordRule"
            },
            "contentMediaType": {
              "$ref": "#/$defs/keywordRule"
            },
            "contentSchema": {
              "$ref": "#/$defs/keywordRule"
            },
            "x-*": {
              "$ref": "#/$defs/keywordRule"
            },
            "unevaluatedItems": {
              "$ref": "#/$defs/keywordRule"
            },
            "unevaluatedProperties": {
              "$ref": "#/$defs/keywordRule"
            }
          },
          "required": [
            "$schema",
            "$ref",
            "$defs",
            "$comment",
            "allOf",
            "anyOf",
            "oneOf",
            "not",
            "if",
            "then",
            "else",
            "dependentSchemas",
            "prefixItems",
            "items",
            "contains",
            "minContains",
            "maxContains",
            "properties",
            "patternProperties",
            "additionalProperties",
            "propertyNames",
            "type",
            "enum",
            "const",
            "multipleOf",
            "maximum",
            "exclusiveMaximum",
            "minimum",
            "exclusiveMinimum",
            "maxLength",
            "minLength",
            "pattern",
            "maxItems",
            "minItems",
            "uniqueItems",
            "maxProperties",
            "minProperties",
            "required",
            "dependentRequired",
            "title",
            "description",
            "default",
            "deprecated",
            "readOnly",
            "writeOnly",
            "examples",
            "format",
            "contentEncoding",
            "contentMediaType",
            "contentSchema",
            "x-*",
            "unevaluatedItems",
            "unevaluatedProperties"
          ],
          "type": "object"
        }
      },
      "required": [
        "keyword_rules"
      ],
      "type": "object"
    }
  },
  "required": [
    "canonical_json",
    "compatibility",
    "conformance",
    "diagnostics",
    "implementation_roles",
    "normative_artifacts",
    "portable_limits",
    "profile_id",
    "profile_version",
    "publication",
    "references",
    "regex_profile",
    "schema_draft",
    "schema_profile",
    "work_units"
  ],
  "type": "object"
}
