{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["code", "path", "severity"],
  "properties": {
    "code": {"type": "string", "pattern": "^agent_profile\\.[a-z][a-z0-9_]*$"},
    "path": {"type": "string", "pattern": "^(?:|(?:/(?:[^~/]|~0|~1)*)*)$"},
    "severity": {"const": "error"}
  },
  "additionalProperties": false
}
