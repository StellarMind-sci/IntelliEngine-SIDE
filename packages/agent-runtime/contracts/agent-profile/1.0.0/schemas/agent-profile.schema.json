{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["contract_version", "id", "revision", "display_name", "persona", "goals", "working_style", "declared_capabilities", "collaboration_preferences", "provenance_refs"],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "display_name": {"type": "string", "minLength": 1},
    "persona": {
      "type": "object",
      "required": ["summary", "principles", "communication_style"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "principles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "communication_style": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "working_style": {
      "type": "object",
      "required": ["planning_preference", "reasoning_preference", "verification_preference"],
      "properties": {
        "planning_preference": {"type": "string", "minLength": 1},
        "reasoning_preference": {"type": "string", "minLength": 1},
        "verification_preference": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "declared_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*$"}, "uniqueItems": true},
    "collaboration_preferences": {
      "type": "object",
      "required": ["interaction_preference", "feedback_preference"],
      "properties": {
        "interaction_preference": {"type": "string", "minLength": 1},
        "feedback_preference": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "provenance_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false
}
